# Ye ek TEMPLATE hai (example). Isse copy karke ".env" banayenge
# aur usme apni asli key daalenge. Is example file mein asli key NAHI daalni.

GEMINI_API_KEY=yaha_apni_gemini_key_paste_karna

# Optional: comma-separated model fallback order (default: see gemini_helper.py)
# GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.5-flash

# Required to upload/reset coding standards from the UI (they apply to every user).
# Leave unset to disable uploads. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(24))"
# ADMIN_TOKEN=

# Extra allowed browser origins, comma-separated (localhost on any port is always allowed).
# Only needed when the frontend is served from another domain, e.g. Vercel.
# CORS_ORIGINS=https://your-frontend.vercel.app

# Database (default: SQLite file). Hosted Postgres URLs work as-is:
# DATABASE_URL=postgres://user:pass@host:5432/dbname
